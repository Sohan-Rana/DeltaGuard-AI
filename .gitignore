# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Node
node_modules/
frontend/dist/

# Secrets (never commit these)
.env
*.pem
*.json.key
service-account*.json
earthengine-credentials*

# Data (large files are not kept in git; metadata is)
data/raw/*
data/processed/*
data/external/*
!data/**/.gitkeep
!data/**/README.md
!data/**/*.metadata.json

# Model artifacts (use DVC / Releases if large)
models/*.pkl
models/*.joblib
models/*.ubj

# OS / IDE
.DS_Store
.vscode/
.idea/
